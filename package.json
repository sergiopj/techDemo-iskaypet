{
  "name": "animal-clinic-backend",
  "version": "1.0.0",
  "description": "Backend API for Animal Clinic",
  "main": "index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "ts-node-dev --respawn ./src/server.ts",
    "start:dev": "ts-node-dev --respawn ./src/server.ts",
    "test": "npx jest",
    "seed": "ts-node ./src/scripts/seedRunner.ts",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/data-source.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiopj/animal-clinic-backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sergiopj/animal-clinic-backend/issues"
  },
  "homepage": "https://github.com/sergiopj/animal-clinic-backend.git#readme",
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/typeorm": "^12.0.2",
    "body-parser": "^1.20.1",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^6.15.0",
    "log4js": "^6.8.0",
    "moment": "^2.30.1",
    "mongoose": "^7.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.0",
    "@types/supertest": "^2.0.12",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^29.4.3",
    "nodemon": "^2.0.20",
    "prettier": "^2.8.4",
    "supertest": "^6.3.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
