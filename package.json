{
  "name": "animal-clinic-backend",
  "version": "1.0.0",
  "description": "Animal Clinic API built with NestJS",
  "main": "dist/nest-main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node ./dist/nest-main.js",
    "start:dev": "ts-node-dev --respawn ./src/nest-main.ts",
    "test": "npx jest",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:generate": "npm run typeorm -- migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/infrastructure/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/infrastructure/database/data-source.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sergiopj/animal-clinic-backend.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sergiopj/animal-clinic-backend/issues"
  },
  "homepage": "https://github.com/sergiopj/animal-clinic-backend.git#readme",
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.3.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@nestjs/typeorm": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.0.3",
    "jwks-rsa": "^4.1.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.1.14",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.4.0",
    "@types/node": "^18.14.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "jest": "^29.4.3",
    "prettier": "^2.8.4",
    "swagger-ui-express": "^4.6.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  }
}
